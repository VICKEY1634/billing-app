import React, { useState, useEffect, useRef } from 'react';

export default function QuickBillApp() {
  const [items, setItems] = useState([]);
  const [billNo, setBillNo] = useState(() => localStorage.getItem('quickBill_currentNo') || '#1');
  const [customUnits, setCustomUnits] = useState(() => JSON.parse(localStorage.getItem('quickBill_units')) || ['pcs', 'gms', 'lines']);
  
  // Settings & Controls
  const [fontSize, setFontSize] = useState(11);
  const [copyCount, setCopyCount] = useState(1);
  const [pageSize, setPageSize] = useState('4x6'); // Default set to 4x6
  
  // QR Checkboxes - Default unchecked as requested
  const [showQr, setShowQr] = useState(false);
  const [showLocationQr, setShowLocationQr] = useState(false);
  const [showAdQr, setShowAdQr] = useState(false);

  // QR Inputs
  const [upiId, setUpiId] = useState('vickey1634@ybl');
  const [qr1Size, setQr1Size] = useState(60);
  const [locationUrl, setLocationUrl] = useState('https://maps.google.com');
  const [qr2Size, setQr2Size] = useState(60);
  const [adUrl, setAdUrl] = useState('https://drive.google.com');
  const [qr3Size, setQr3Size] = useState(60);

  // Store & Customer info
  const [storeName, setStoreName] = useState('CASH');
  const [storePhone, setStorePhone] = useState('Phone: 0');
  const [custPhone, setCustPhone] = useState('');
  const [stoneWt, setStoneWt] = useState(0);
  
  // Discount
  const [discountPercent, setDiscountPercent] = useState(0);
  const [discountAmount, setDiscountAmount] = useState(0);

  // Meta WhatsApp
  const [waPhoneId, setWaPhoneId] = useState(() => localStorage.getItem('quickBill_waPhoneId') || '');
  const [waToken, setWaToken] = useState(() => localStorage.getItem('quickBill_waToken') || '');

  // Form Inputs for New Item
  const [newItemName, setNewItemName] = useState('');
  const [newItemQty, setNewItemQty] = useState(1);
  const [newItemUnit, setNewItemUnit] = useState('pcs');
  const [newItemPrice, setNewItemPrice] = useState('');

  // Refs for QR containers
  const upiQrRef = useRef(null);
  const locQrRef = useRef(null);
  const adQrRef = useRef(null);

  // Render QR Codes whenever values change
  useEffect(() => {
    if (showQr && upiQrRef.current) {
      upiQrRef.current.innerHTML = '';
      try {
        new QRCode(upiQrRef.current, {
          text: `upi://pay?pa=${upiId}&pn=Merchant&cu=INR`,
          width: qr1Size,
          height: qr1Size,
        });
      } catch (e) {}
    }
  }, [showQr, upiId, qr1Size]);

  useEffect(() => {
    if (showLocationQr && locQrRef.current) {
      locQrRef.current.innerHTML = '';
      try {
        new QRCode(locQrRef.current, {
          text: locationUrl,
          width: qr2Size,
          height: qr2Size,
        });
      } catch (e) {}
    }
  }, [showLocationQr, locationUrl, qr2Size]);

  useEffect(() => {
    if (showAdQr && adQrRef.current) {
      adQrRef.current.innerHTML = '';
      try {
        new QRCode(adQrRef.current, {
          text: adUrl,
          width: qr3Size,
          height: qr3Size,
        });
      } catch (e) {}
    }
  }, [showAdQr, adUrl, qr3Size]);

  const subTotal = items.reduce((acc, curr) => acc + curr.total, 0);
  const grandTotal = Math.max(0, subTotal - discountAmount);

  const addItem = () => {
    if (!newItemName.trim()) {
      alert("Please enter item name!");
      return;
    }
    const qty = parseFloat(newItemQty) || 1;
    const price = parseFloat(newItemPrice) || 0;
    const newItem = {
      id: Date.now(),
      name: newItemName,
      qty,
      unit: newItemUnit,
      price,
      total: qty * price
    };
    setItems([...items, newItem]);
    setNewItemName('');
    setNewItemQty(1);
    setNewItemPrice('');
  };

  const deleteItem = (id) => {
    setItems(items.filter(item => item.id !== id));
  };

  const clearBill = () => {
    if (window.confirm("Are you sure you want to reset the bill?")) {
      setItems([]);
      setCustPhone('');
      setStoneWt(0);
      setDiscountPercent(0);
      setDiscountAmount(0);
    }
  };

  const handleUnitChange = (e) => {
    const val = e.target.value;
    if (val === '__add_new__') {
      const newU = prompt("Enter new unit name (e.g. kg, meter, packet):");
      if (newU && newU.trim()) {
        const trimmed = newU.trim();
        if (!customUnits.includes(trimmed)) {
          const updated = [...customUnits, trimmed];
          setCustomUnits(updated);
          localStorage.setItem('quickBill_units', JSON.stringify(updated));
        }
        setNewItemUnit(trimmed);
      } else {
        setNewItemUnit(customUnits[0]);
      }
    } else {
      setNewItemUnit(val);
    }
  };

  const saveWaApiKeys = () => {
    localStorage.setItem('quickBill_waPhoneId', waPhoneId);
    localStorage.setItem('quickBill_waToken', waToken);
    alert("Meta API Credentials Saved!");
  };

  const sendWhatsAppDirectApi = async () => {
    if (!waPhoneId || !waToken) {
      alert("Pehle Meta Phone Number ID aur Access Token save karein!");
      return;
    }
    let phone = custPhone.trim();
    if (!phone) phone = prompt("Customer Phone Number:");
    if (!phone) return;

    let cleanPhone = phone.replace(/[^0-9]/g, '');
    if (cleanPhone.length === 10) cleanPhone = '91' + cleanPhone;

    alert(`Simulating WhatsApp API dispatch to ${cleanPhone}. Total: ₹${grandTotal.toFixed(2)}`);
  };

  const triggerPrint = () => {
    window.print();
  };

  return (
    <div className="notranslate" translate="no" style={{ backgroundColor: '#f0f2f5', minHeight: '100vh', padding: '20px', fontFamily: "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif" }}>
      <style>{`
        * { box-sizing: border-box; }
        .control-panel { background: #ffffff; padding: 18px 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); width: 100%; max-width: 950px; margin: 0 auto 25px auto; border: 1px solid #e1e4e8; }
        .panel-header { font-size: 16px; font-weight: 700; color: #1a365d; margin-bottom: 15px; border-bottom: 2px solid #edf2f7; padding-bottom: 12px; display: flex; justify-content: space-between; align-items: center; }
        .settings-bar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 15px; background: #f8fafc; padding: 10px; border-radius: 8px; border: 1px solid #e2e8f0; }
        .setting-box { display: flex; align-items: center; gap: 6px; }
        .form-grid { display: flex; gap: 12px; margin-bottom: 15px; flex-wrap: wrap; }
        .form-group { display: flex; flex-direction: column; }
        .form-group label, .setting-box label { font-size: 11px; font-weight: 700; color: #4a5568; text-transform: uppercase; letter-spacing: 0.5px; }
        input, select, button { padding: 8px 10px; border: 1px solid #cbd5e0; border-radius: 6px; font-size: 13px; outline: none; transition: all 0.2s ease; }
        input:focus, select:focus { border-color: #3182ce; box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.15); }
        .btn-add { background-color: #2b6cb0; color: white; font-weight: 600; cursor: pointer; border: none; height: 38px; align-self: flex-end; }
        .btn-add:hover { background-color: #2c5282; }
        .btn-whatsapp { background-color: #25d366; color: white; font-weight: 700; font-size: 13px; cursor: pointer; border: none; padding: 8px 14px; border-radius: 6px; }
        .btn-print { background-color: #2f855a; color: white; font-weight: 700; font-size: 13px; cursor: pointer; border: none; padding: 8px 14px; border-radius: 6px; }
        .btn-clear { background-color: #e53e3e; color: white; font-weight: 600; cursor: pointer; border: none; padding: 8px 14px; border-radius: 6px; }
        .action-bar { display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding-top: 15px; border-top: 1px dashed #e2e8f0; flex-wrap: wrap; gap: 10px; }
        
        .invoice-container { background: #ffffff; margin: 0 auto 20px auto; padding: 15px; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); font-size: ${fontSize}px !important; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; position: relative; }
        .invoice-container *, .invoice-container h1, .invoice-container p, .invoice-container td, .invoice-container th, .invoice-container span, .invoice-container div { font-size: ${fontSize}px !important; line-height: 1.2; }
        .estimate-heading { text-align: center; font-size: 12px !important; font-weight: 800; letter-spacing: 1.5px; margin-bottom: 6px; text-transform: uppercase; color: #000; }
        
        .size-A4 { width: 210mm; min-height: 297mm; }
        .size-4x6 { width: 4in; height: 5.8in; padding: 10px !important; }
        .size-5x7 { width: 5in; height: 6.8in; padding: 12px !important; }

        .invoice-header { display: flex; justify-content: space-between; border-bottom: 1.5px solid #000; padding-bottom: 6px; margin-bottom: 8px; }
        .company-details h1 { margin: 0; font-weight: 700; color: #000; text-transform: uppercase; outline: none; }
        .company-details p { margin: 2px 0; color: #000; }
        .invoice-table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
        .invoice-table th { background-color: #f0f0f0; color: #000; font-weight: 700; text-transform: uppercase; padding: 4px 6px; border-bottom: 1.5px solid #000; text-align: left; }
        .invoice-table td { padding: 4px 6px; border-bottom: 1px solid #ccc; color: #000; }
        .text-right { text-align: right !important; }
        .text-center { text-align: center !important; }
        .invoice-summary { display: flex; justify-content: flex-end; margin-top: 6px; }
        .summary-box { width: 100%; max-width: 320px; background: rgba(255, 255, 255, 0.85); border: 1.5px solid #000; border-radius: 4px; padding: 6px; }
        .summary-row { display: flex; justify-content: space-between; align-items: center; padding: 2px 0; }
        .summary-input { width: 60px; padding: 2px 4px; text-align: right; border: 1px solid #888; }
        .summary-row.grand-total { border-top: 1.5px solid #000; font-weight: bold; color: #000; padding-top: 3px; margin-top: 3px; }
        .footer-section { margin-top: auto; border-top: 1px solid #ccc; padding-top: 6px; display: flex; justify-content: space-between; align-items: flex-end; }
        .qr-wrapper { display: flex; gap: 8px; align-items: flex-end; }
        .qr-container-corner { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
        .qr-code-box { display: flex; align-items: center; justify-content: center; background: #fff; padding: 4px; border: 1px solid #000; }
        .qr-label { font-size: 7px !important; font-weight: bold; margin-top: 2px; color: #000; text-transform: uppercase; }

        @media print {
          @page { size: ${pageSize === 'A4' ? 'A4' : pageSize === '4x6' ? '4in 6in' : '5in 7in'}; margin: 0 !important; }
          body { background: white !important; color: black !important; padding: 0 !important; margin: 0 !important; }
          .no-print { display: none !important; }
          .invoice-container { box-shadow: none !important; border: none !important; width: 100% !important; margin: 0 !important; }
        }
      `}</style>

      {/* Control Panel */}
      <div className="control-panel no-print">
        <div className="panel-header">
          <span>⚙️ Billing Control Panel</span>
        </div>

        <div className="settings-bar">
          <div className="setting-box" style={{ background: '#edf2f7', padding: '4px 8px', borderRadius: '6px' }}>
            <label htmlFor="fontSizeSlider">🔤 Font Size:</label>
            <input 
              type="range" 
              id="fontSizeSlider" 
              min="9" 
              max="20" 
              value={fontSize} 
              step="1" 
              onChange={(e) => setFontSize(Number(e.target.value))} 
              style={{ width: '80px', cursor: 'pointer' }}
            />
            <span style={{ fontSize: '11px', fontWeight: 'bold', width: '32px', color: '#2b6cb0' }}>{fontSize}px</span>
          </div>

          <div className="setting-box">
            <label htmlFor="copyCount">🖨️ Copies:</label>
            <input 
              type="number" 
              id="copyCount" 
              value={copyCount} 
              min="1" 
              max="10" 
              onChange={(e) => setCopyCount(Number(e.target.value))}
              style={{ width: '50px', fontWeight: 'bold', textAlign: 'center', padding: '4px' }}
            />
          </div>
          
          <div className="setting-box">
            <label htmlFor="pageSizeSelect">📄 Size:</label>
            <select 
              id="pageSizeSelect" 
              value={pageSize} 
              onChange={(e) => setPageSize(e.target.value)} 
              style={{ fontWeight: 'bold', color: '#2b6cb0', padding: '4px' }}
            >
              <option value="4x6">4 x 6 Inches (Thermal / Small)</option>
              <option value="A4">A4 Size (Standard)</option>
              <option value="5x7">5 x 7 Inches (Medium Slip)</option>
            </select>
          </div>
        </div>

        {/* Meta WhatsApp Cloud API Settings */}
        <div style={{ background: '#f0fdf4', border: '1px solid #bbf7d0', padding: '12px', borderRadius: '8px', marginBottom: '15px' }}>
          <label style={{ fontSize: '11px', fontWeight: '700', color: '#166534', textTransform: 'uppercase', display: 'block', marginBottom: '6px' }}>💬 Meta WhatsApp Direct Cloud API Credentials:</label>
          <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap' }}>
            <input 
              type="text" 
              placeholder="Meta Phone Number ID" 
              value={waPhoneId} 
              onChange={(e) => setWaPhoneId(e.target.value)} 
              style={{ flex: 1, minWidth: '180px' }}
            />
            <input 
              type="password" 
              placeholder="Meta Permanent Access Token" 
              value={waToken} 
              onChange={(e) => setWaToken(e.target.value)} 
              style={{ flex: 2, minWidth: '220px' }}
            />
            <button type="button" onClick={saveWaApiKeys} style={{ background:'#166534', color:'white', border:'none', fontWeight:'bold', cursor:'pointer', padding:'6px 12px', borderRadius:'6px' }}>Save Keys</button>
          </div>
        </div>

        {/* QR Code Inputs - Both default unchecked */}
        <div style={{ background: '#eef2ff', border: '1px solid #c7d2fe', padding: '12px', borderRadius: '8px', marginBottom: '15px' }}>
          <div style={{ marginBottom: '10px' }}>
            <label style={{ fontSize: '11px', fontWeight: '700', color: '#3730a3', textTransform: 'uppercase', display: 'block', marginBottom: '4px' }}>💳 1. Dynamic UPI Payment QR Code:</label>
            <div style={{ display: 'flex', gap: '8px', alignItems: 'center', flexWrap: 'wrap' }}>
              <input 
                type="text" 
                value={upiId} 
                onChange={(e) => setUpiId(e.target.value)} 
                style={{ flex: 2, minWidth: '180px', padding: '7px 10px', fontSize: '13px' }} 
              />
              <div style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                <label style={{ fontSize: '11px', fontWeight: 'bold' }}>Size:</label>
                <input 
                  type="range" 
                  min="40" 
                  max="120" 
                  value={qr1Size} 
                  step="5" 
                  onChange={(e) => setQr1Size(Number(e.target.value))} 
                  style={{ width: '70px', cursor: 'pointer' }}
                />
                <span style={{ fontSize: '11px', fontWeight: 'bold', color: '#3730a3', width: '32px' }}>{qr1Size}px</span>
              </div>
              <label style={{ display: 'flex', alignItems: 'center', gap: '4px', fontSize: '12px', fontWeight: 'bold', cursor: 'pointer', color: '#1e293b', whiteSpace: 'nowrap' }}>
                <input 
                  type="checkbox" 
                  checked={showQr} 
                  onChange={(e) => setShowQr(e.target.checked)} 
                /> Show UPI QR
              </label>
            </div>
          </div>

          <div style={{ borderTop: '1px dashed #c7d2fe', paddingTop: '8px', marginBottom: '10px' }}>
            <label style={{ fontSize: '11px', fontWeight: '700', color: '#3730a3', textTransform: 'uppercase', display: 'block', marginBottom: '4px' }}>📍 2. Location QR Code (Google Maps Link):</label>
            <div style={{ display: 'flex', gap: '8px', alignItems: 'center', flexWrap: 'wrap' }}>
              <input 
                type="text" 
                value={locationUrl} 
                onChange={(e) => setLocationUrl(e.target.value)} 
                style={{ flex: 2, minWidth: '180px', padding: '7px 10px', fontSize: '13px' }}
              />
              <div style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                <label style={{ fontSize: '11px', fontWeight: 'bold' }}>Size:</label>
                <input 
                  type="range" 
                  min="40" 
                  max="120" 
                  value={qr2Size} 
                  step="5" 
                  onChange={(e) => setQr2Size(Number(e.target.value))} 
                  style={{ width: '70px', cursor: 'pointer' }}
                />
                <span style={{ fontSize: '11px', fontWeight: 'bold', color: '#3730a3', width: '32px' }}>{qr2Size}px</span>
              </div>
              <label style={{ display: 'flex', alignItems: 'center', gap: '4px', fontSize: '12px', fontWeight: 'bold', cursor: 'pointer', color: '#1e293b', whiteSpace: 'nowrap' }}>
                <input 
                  type="checkbox" 
                  checked={showLocationQr} 
                  onChange={(e) => setShowLocationQr(e.target.checked)} 
                /> Show Location QR
              </label>
            </div>
          </div>

          <div style={{ borderTop: '1px dashed #c7d2fe', paddingTop: '8px' }}>
            <label style={{ fontSize: '11px', fontWeight: '700', color: '#3730a3', textTransform: 'uppercase', display: 'block', marginBottom: '4px' }}>📢 3. Gallery Media & Promo QR Code:</label>
            <div style={{ display: 'flex', gap: '8px', alignItems: 'center', flexWrap: 'wrap' }}>
              <input 
                type="text" 
                value={adUrl} 
                onChange={(e) => setAdUrl(e.target.value)} 
                style={{ flex: 2, minWidth: '180px', padding: '7px 10px', fontSize: '13px' }}
              />
              <div style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                <label style={{ fontSize: '11px', fontWeight: 'bold' }}>Size:</label>
                <input 
                  type="range" 
                  min="40" 
                  max="120" 
                  value={qr3Size} 
                  step="5" 
                  onChange={(e) => setQr3Size(Number(e.target.value))} 
                  style={{ width: '70px', cursor: 'pointer' }}
                />
                <span style={{ fontSize: '11px', fontWeight: 'bold', color: '#3730a3', width: '32px' }}>{qr3Size}px</span>
              </div>
              <label style={{ display: 'flex', alignItems: 'center', gap: '4px', fontSize: '12px', fontWeight: 'bold', cursor: 'pointer', color: '#1e293b', whiteSpace: 'nowrap' }}>
                <input 
                  type="checkbox" 
                  checked={showAdQr} 
                  onChange={(e) => setShowAdQr(e.target.checked)} 
                /> Show Promo QR
              </label>
            </div>
          </div>
        </div>

        {/* Item Entry Form */}
        <div className="form-grid">
          <div className="form-group" style={{ flex: 1.5, minWidth: '150px' }}>
            <label>Customer Phone No</label>
            <input 
              type="text" 
              placeholder="E.g. 9700271634" 
              value={custPhone} 
              onChange={(e) => setCustPhone(e.target.value)} 
            />
          </div>
          <div className="form-group" style={{ flex: 2, minWidth: '180px' }}>
            <label>Item Ka Naam</label>
            <input 
              type="text" 
              placeholder="E.g. Ring, Chain, Service..." 
              value={newItemName} 
              onChange={(e) => setNewItemName(e.target.value)} 
            />
          </div>
          <div className="form-group" style={{ flex: 1, minWidth: '80px' }}>
            <label>Qty</label>
            <input 
              type="number" 
              value={newItemQty} 
              min="0.01" 
              step="any" 
              onChange={(e) => setNewItemQty(e.target.value)} 
            />
          </div>
          <div className="form-group" style={{ flex: 1, minWidth: '90px' }}>
            <label>Unit</label>
            <select value={newItemUnit} onChange={handleUnitChange}>
              {customUnits.map(u => <option key={u} value={u}>{u}</option>)}
              <option value="__add_new__" style={{ fontWeight: 'bold', color: '#2b6cb0' }}>+ Add New Unit</option>
            </select>
          </div>
          <div className="form-group" style={{ flex: 1, minWidth: '90px' }}>
            <label>Rate (₹)</label>
            <input 
              type="number" 
              placeholder="0.00" 
              min="0" 
              step="any" 
              value={newItemPrice} 
              onChange={(e) => setNewItemPrice(e.target.value)} 
            />
          </div>
          <div className="form-group" style={{ display: 'flex', gap: '6px' }}>
            <button type="button" className="btn-add" onClick={addItem}>+ Add Item</button>
          </div>
        </div>

        <div className="action-bar">
          <button type="button" className="btn-clear" onClick={clearBill}>🗑️ Reset Entire Bill</button>
          <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap' }}>
            <button type="button" className="btn-whatsapp" onClick={sendWhatsAppDirectApi}>⚡ Direct Cloud WhatsApp</button>
            <button type="button" className="btn-print" onClick={triggerPrint}>🖨️ Print Invoice</button>
          </div>
        </div>
      </div>

      {/* Invoice Slip Preview */}
      <div id="printWrapper">
        <div id="invoice" className={`invoice-container size-${pageSize}`}>
          <div>
            <div className="estimate-heading">ESTIMATE</div>

            <div className="invoice-header">
              <div className="company-details">
                <h1 contentEditable={true} suppressContentEditableWarning={true} onBlur={(e) => setStoreName(e.target.innerText)}>{storeName}</h1>
                <p contentEditable={true} suppressContentEditableWarning={true} onBlur={(e) => setStorePhone(e.target.innerText)}>{storePhone}</p>
                <p>Customer Phone: <span>{custPhone || '0'}</span></p>
              </div>
              <div style={{ textAlign: 'right' }}>
                <p><strong>INVOICE NO:</strong> <input type="text" value={billNo} onChange={(e) => setBillNo(e.target.value)} style={{ fontWeight: 'bold', border: '1px dashed #888', padding: '1px 4px', borderRadius: '4px', width: '80px', textAlign: 'right' }} /></p>
                <p><strong>DATE:</strong> {new Date().toLocaleDateString()}</p>
                <p><strong>TIME:</strong> {new Date().toLocaleTimeString()}</p>
              </div>
            </div>

            <table className="invoice-table">
              <thead>
                <tr>
                  <th style={{ width: '6%' }}>S.No</th>
                  <th>Item Description</th>
                  <th className="text-center" style={{ width: '12%' }}>Qty</th>
                  <th className="text-center" style={{ width: '12%' }}>Unit</th>
                  <th className="text-right" style={{ width: '18%' }}>Rate (₹)</th>
                  <th className="text-right" style={{ width: '20%' }}>Total (₹)</th>
                  <th className="no-print" style={{ width: '10%' }}>Actions</th>
                </tr>
              </thead>
              <tbody>
                {items.map((item, index) => (
                  <tr key={item.id}>
                    <td>{index + 1}</td>
                    <td>{item.name}</td>
                    <td className="text-center">{item.qty}</td>
                    <td className="text-center">{item.unit}</td>
                    <td className="text-right">{item.price.toFixed(2)}</td>
                    <td className="text-right">{item.total.toFixed(2)}</td>
                    <td className="no-print text-center">
                      <button onClick={() => deleteItem(item.id)} style={{ color: '#e53e3e', cursor: 'pointer', border: 'none', background: 'none', fontWeight: 'bold' }}>✕</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>

            <div className="invoice-summary">
              <div className="summary-box">
                <div className="summary-row">
                  <span>Sub Total:</span>
                  <span>₹{subTotal.toFixed(2)}</span>
                </div>
                <div className="summary-row">
                  <span>Discount:</span>
                  <div className="no-print" style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                    <input 
                      type="number" 
                      className="summary-input" 
                      value={discountPercent} 
                      min="0" 
                      max="100" 
                      onChange={(e) => {
                        const p = parseFloat(e.target.value) || 0;
                        setDiscountPercent(p);
                        setDiscountAmount((subTotal * p) / 100);
                      }} 
                    />% / ₹
                    <input 
                      type="number" 
                      className="summary-input" 
                      value={discountAmount} 
                      min="0" 
                      onChange={(e) => {
                        const amt = parseFloat(e.target.value) || 0;
                        setDiscountAmount(amt);
                        setDiscountPercent(subTotal > 0 ? (amt / subTotal) * 100 : 0);
                      }} 
                    />
                  </div>
                </div>
                <div className="summary-row grand-total">
                  <span>Grand Total:</span>
                  <span>₹{grandTotal.toFixed(2)}</span>
                </div>
              </div>
            </div>
          </div>

          <div className="footer-section">
            <div style={{ textAlign: 'left', flex: 1 }}>
              <p style={{ margin: 0 }}>Thank you for your business! Visit Again.</p>
            </div>
            <div className="qr-wrapper">
              {showAdQr && (
                <div className="qr-container-corner">
                  <div ref={adQrRef} className="qr-code-box"></div>
                  <div className="qr-label">📢 OFFERS</div>
                </div>
              )}
              {showLocationQr && (
                <div className="qr-container-corner">
                  <div ref={locQrRef} className="qr-code-box"></div>
                  <div className="qr-label">📍 LOCATION</div>
                </div>
              )}
              {showQr && (
                <div className="qr-container-corner">
                  <div ref={upiQrRef} className="qr-code-box"></div>
                  <div className="qr-label">SCAN & PAY</div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
