<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuickBill Pro - Billing Software</title>
    <style id="page-style">
        @page {
            size: 5in 7in;
            margin: 0 !important;
        }
    </style>
    <style>
        * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #f0f2f5; margin: 0; padding: 20px; color: #333; }
        .control-panel { background: #ffffff; padding: 18px 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); width: 100%; max-width: 950px; margin: 0 auto 25px auto; border: 1px solid #e1e4e8; display: block !important; }
        .panel-header { font-size: 16px; font-weight: 700; color: #1a365d; margin-bottom: 15px; border-bottom: 2px solid #edf2f7; padding-bottom: 12px; display: flex; justify-content: space-between; align-items: center; }
        .settings-bar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 15px; background: #f8fafc; padding: 10px; border-radius: 8px; border: 1px solid #e2e8f0; }
        .setting-box { display: flex; align-items: center; gap: 6px; }
        .btn-save-default { background-color: #2b6cb0; color: white; font-weight: 600; font-size: 12px; cursor: pointer; border: none; padding: 7px 12px; border-radius: 6px; margin-left: 8px; }
        .btn-save-default:hover { background-color: #2c5282; }
        .btn-history { background-color: #4c51bf; color: white; font-weight: 600; font-size: 13px; cursor: pointer; border: none; padding: 7px 14px; border-radius: 6px; margin-left: auto; }
        .btn-history:hover { background-color: #434190; }
        .form-grid { display: flex; gap: 12px; margin-bottom: 15px; flex-wrap: wrap; }
        .form-group { display: flex; flex-direction: column; }
        .form-group label, .setting-box label { font-size: 11px; font-weight: 700; color: #4a5568; text-transform: uppercase; letter-spacing: 0.5px; }
        input, select, textarea, button { padding: 8px 10px; border: 1px solid #cbd5e0; border-radius: 6px; font-size: 13px; outline: none; transition: all 0.2s ease; }
        input:focus, select:focus, textarea:focus { border-color: #3182ce; box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.15); }
        .btn-add { background-color: #2b6cb0; color: white; font-weight: 600; cursor: pointer; border: none; height: 38px; align-self: flex-end; }
        .btn-add:hover { background-color: #2c5282; }
        .btn-preview { background-color: #4a5568; color: white; font-weight: 600; font-size: 13px; cursor: pointer; border: none; padding: 8px 14px; border-radius: 6px; }
        .btn-preview:hover { background-color: #2d3748; }
        .btn-print { background-color: #2f855a; color: white; font-weight: 700; font-size: 13px; cursor: pointer; border: none; padding: 8px 14px; border-radius: 6px; }
        .btn-print:hover { background-color: #276749; }
        .btn-clear { background-color: #e53e3e; color: white; font-weight: 600; cursor: pointer; border: none; padding: 8px 14px; border-radius: 6px; }
        .btn-clear:hover { background-color: #c53030; }
        .action-bar { display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding-top: 15px; border-top: 1px dashed #e2e8f0; }
        .invoice-container { --bill-font-size: 11px; background: #ffffff; margin: 0 auto 20px auto; padding: 15px; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); transition: all 0.3s ease; box-sizing: border-box; font-size: var(--bill-font-size) !important; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; position: relative; z-index: 1; }
        .watermark-overlay { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 55%; height: auto; opacity: 0.06; pointer-events: none; z-index: -1; }
        .invoice-container *, .invoice-container h1, .invoice-container p, .invoice-container td, .invoice-container th, .invoice-container span, .invoice-container div, .invoice-container input { font-size: var(--bill-font-size) !important; line-height: 1.2; }
        .estimate-heading { text-align: center; font-size: 12px !important; font-weight: 800; letter-spacing: 1.5px; margin-bottom: 6px; text-transform: uppercase; color: #000; }
        .size-a4 { width: 210mm; min-height: 297mm; }
        .size-4x6 { width: 4in; height: 5.8in; padding: 10px !important; }
        .size-5x7 { width: 5in; height: 6.8in; padding: 12px !important; }
        .invoice-header { display: flex; justify-content: space-between; border-bottom: 1.5px solid #000; padding-bottom: 6px; margin-bottom: 8px; }
        .company-details h1 { margin: 0; font-weight: 700; color: #000; text-transform: uppercase; outline: none; }
        .company-details p { margin: 2px 0; color: #000; outline: none; }
        .stone-wt-header-row { margin-top: 4px; font-weight: bold; color: #000; display: flex; align-items: center; gap: 4px; }
        .bill-meta { text-align: right; }
        .bill-meta p { margin: 2px 0; }
        .bill-meta span { font-weight: bold; color: #000; }
        .invoice-table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
        .invoice-table th { background-color: #f0f0f0; color: #000; font-weight: 700; text-transform: uppercase; padding: 4px 6px; border-bottom: 1.5px solid #000; text-align: left; }
        .invoice-table td { padding: 4px 6px; border-bottom: 1px solid #ccc; color: #000; }
        .text-right { text-align: right !important; }
        .text-center { text-align: center !important; }
        .invoice-summary { display: flex; justify-content: flex-end; margin-top: 6px; }
        .summary-box { width: 100%; max-width: 320px; background: rgba(255, 255, 255, 0.85); border: 1.5px solid #000; border-radius: 4px; padding: 6px; }
        .summary-row { display: flex; justify-content: space-between; align-items: center; padding: 2px 0; }
        .summary-input { width: 60px; padding: 2px 4px; text-align: right; border: 1px solid #888; }
        .summary-row.grand-total { border-top: 1.5px solid #000; font-weight: bold; color: #000; padding-top: 3px; margin-top: 3px; }
        .delete-btn { color: #e53e3e; cursor: pointer; font-weight: bold; border: none; background: none; padding: 0 4px; }
        .footer-section { margin-top: auto; border-top: 1px solid #ccc; padding-top: 6px; display: flex; justify-content: space-between; align-items: flex-end; position: relative; }
        .footer-note { text-align: left; color: #000; flex: 1; padding-right: 10px; }
        .qr-wrapper { display: flex; gap: 8px; align-items: flex-end; }
        .qr-container-corner { display: none; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
        .qr-code-box { display: flex; align-items: center; justify-content: center; background: #fff; padding: 2px; border: 1px solid #000; }
        .qr-code-box canvas { max-width: 100%; max-height: 100%; }
        .qr-label { font-size: 7px !important; font-weight: bold; margin-top: 2px; color: #000; text-transform: uppercase; }
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.75); z-index: 9999; justify-content: center; align-items: center; }
        .modal-card { background: #fff; border-radius: 10px; padding: 20px; max-height: 90vh; overflow-y: auto; box-shadow: 0 10px 25px rgba(0,0,0,0.3); display: flex; flex-direction: column; align-items: center; }
        .history-card { width: 90%; max-width: 900px; align-items: stretch; }
        .modal-header { width: 100%; display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 1px solid #ddd; padding-bottom: 10px; }
        .preview-bw-container { filter: grayscale(100%); -webkit-filter: grayscale(100%); background: white; border: 1px solid #333; }
        .history-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        .history-table th, .history-table td { padding: 8px; border: 1px solid #e2e8f0; text-align: left; font-size: 13px; }
        .history-table th { background-color: #edf2f7; color: #2d3748; }
        .print-only { display: none; }

        @media print {
            @page { size: 5in 7in; margin: 0 !important; }
            html, body { background: white !important; color: black !important; filter: grayscale(100%) !important; -webkit-filter: grayscale(100%) !important; padding: 0 !important; margin: 0 !important; height: 100% !important; overflow: hidden !important; }
            .no-print, .modal-overlay { display: none !important; }
            .invoice-container { box-shadow: none !important; border: none !important; padding: 4mm !important; margin: 0 !important; width: 100% !important; max-height: 100% !important; color: #000 !important; page-break-after: avoid !important; page-break-inside: avoid !important; }
            .invoice-container * { color: #000 !important; border-color: #000 !important; }
            .watermark-overlay { opacity: 0.08 !important; }
            .delete-btn { display: none !important; }
            .print-only { display: inline-block !important; }
            .print-hide-row { display: none !important; }
        }
    </style>
</head>
<body>

    <div class="control-panel no-print">
        <div class="panel-header">
            <span>⚙️ Billing Control Panel</span>
        </div>

        <div class="settings-bar">
            <div class="setting-box" style="background: #edf2f7; padding: 4px 8px; border-radius: 6px;">
                <label for="fontSizeSlider">🔤 Font Size:</label>
                <input type="range" id="fontSizeSlider" min="9" max="20" value="11" step="1" oninput="changeFontSize(this.value)" style="width: 80px; cursor: pointer;">
                <span id="fontSizeDisplay" style="font-size: 11px; font-weight: bold; width: 32px; color: #2b6cb0;">11px</span>
            </div>

            <div class="setting-box">
                <label for="copyCount">🖨️ Copies:</label>
                <input type="number" id="copyCount" value="1" min="1" max="10" style="width: 50px; font-weight: bold; text-align: center; padding: 4px;">
            </div>
            
            <div class="setting-box">
                <label for="pageSizeSelect">📄 Size:</label>
                <select id="pageSizeSelect" onchange="changePageSize()" style="font-weight: bold; color: #2b6cb0; padding: 4px;">
                    <option value="4x6">4 x 6 Inches (Thermal / Small)</option>
                    <option value="A4">A4 Size (Standard)</option>
                    <option value="5x7" selected>5 x 7 Inches (Medium Slip)</option>
                </select>
            </div>

            <button type="button" class="btn-save-default" onclick="saveAsDefaultSettings()">💾 Save as Default</button>
            <button type="button" class="btn-history" onclick="openHistoryModal()">📜 History</button>
        </div>

        <!-- QR Code Custom Inputs Section -->
        <div style="background: #eef2ff; border: 1px solid #c7d2fe; padding: 12px; border-radius: 8px; margin-bottom: 15px;">
            <div style="margin-bottom: 10px;">
                <label for="qrTextInput" style="font-size: 11px; font-weight: 700; color: #3730a3; text-transform: uppercase; display: block; margin-bottom: 4px;">💳 1. Payment / Main QR Code (UPI / Text):</label>
                <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                    <input type="text" id="qrTextInput" value="rathan gems, korada street, chinna bazar,, nellore 9700271634" oninput="updateQRCodes()" style="flex: 2; min-width: 180px; padding: 7px 10px; font-size: 13px;">
                    <div style="display: flex; align-items: center; gap: 4px;">
                        <label for="qr1Size" style="font-size: 11px; font-weight: bold;">Size:</label>
                        <input type="range" id="qr1Size" min="30" max="120" value="50" step="5" oninput="updateQRCodes()" style="width: 70px; cursor: pointer;">
                        <span id="qr1SizeDisplay" style="font-size: 11px; font-weight: bold; color: #3730a3; width: 32px;">50px</span>
                    </div>
                    <label style="display: flex; align-items: center; gap: 4px; font-size: 12px; font-weight: bold; cursor: pointer; color: #1e293b; white-space: nowrap;">
                        <input type="checkbox" id="showQrCheckbox" checked onchange="toggleQrVisibility()"> Show QR 1
                    </label>
                </div>
            </div>

            <div style="border-top: 1px dashed #c7d2fe; padding-top: 8px; margin-bottom: 10px;">
                <label for="locationInput" style="font-size: 11px; font-weight: 700; color: #3730a3; text-transform: uppercase; display: block; margin-bottom: 4px;">📍 2. Location QR Code (Google Maps Link):</label>
                <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                    <input type="text" id="locationInput" value="https://maps.google.com" oninput="updateQRCodes()" style="flex: 2; min-width: 180px; padding: 7px 10px; font-size: 13px;">
                    <div style="display: flex; align-items: center; gap: 4px;">
                        <label for="qr2Size" style="font-size: 11px; font-weight: bold;">Size:</label>
                        <input type="range" id="qr2Size" min="30" max="120" value="50" step="5" oninput="updateQRCodes()" style="width: 70px; cursor: pointer;">
                        <span id="qr2SizeDisplay" style="font-size: 11px; font-weight: bold; color: #3730a3; width: 32px;">50px</span>
                    </div>
                    <label style="display: flex; align-items: center; gap: 4px; font-size: 12px; font-weight: bold; cursor: pointer; color: #1e293b; white-space: nowrap;">
                        <input type="checkbox" id="showLocationQrCheckbox" checked onchange="toggleQrVisibility()"> Show Location QR
                    </label>
                </div>
            </div>

            <div style="border-top: 1px dashed #c7d2fe; padding-top: 8px;">
                <label for="adInput" style="font-size: 11px; font-weight: 700; color: #3730a3; text-transform: uppercase; display: block; margin-bottom: 4px;">📢 3. Gallery Media & Promo QR Code:</label>
                <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                    <input type="text" id="adInput" value="https://drive.google.com" oninput="updateQRCodes()" style="flex: 2; min-width: 180px; padding: 7px 10px; font-size: 13px;">
                    <div style="display: flex; align-items: center; gap: 4px;">
                        <label for="qr3Size" style="font-size: 11px; font-weight: bold;">Size:</label>
                        <input type="range" id="qr3Size" min="30" max="120" value="50" step="5" oninput="updateQRCodes()" style="width: 70px; cursor: pointer;">
                        <span id="qr3SizeDisplay" style="font-size: 11px; font-weight: bold; color: #3730a3; width: 32px;">50px</span>
                    </div>
                    <label style="display: flex; align-items: center; gap: 4px; font-size: 12px; font-weight: bold; cursor: pointer; color: #1e293b; white-space: nowrap;">
                        <input type="checkbox" id="showAdQrCheckbox" onchange="toggleQrVisibility()"> Show Promo QR
                    </label>
                </div>
            </div>
        </div>

        <div class="form-grid">
            <div class="form-group" style="flex: 2; min-width: 180px;">
                <label for="itemName">Item Ka Naam</label>
                <input type="text" id="itemName" placeholder="E.g. Ring, Chain, Service..." onkeydown="moveNext(event, 'itemQty')">
            </div>
            <div class="form-group" style="flex: 1; min-width: 80px;">
                <label for="itemQty">Qty</label>
                <input type="number" id="itemQty" placeholder="1" value="1" min="0.01" step="any" onkeydown="moveNext(event, 'itemUnit')">
            </div>
            <div class="form-group" style="flex: 1; min-width: 90px;">
                <label for="itemUnit">Unit</label>
                <select id="itemUnit" onchange="handleUnitChange(this)" onkeydown="moveNext(event, 'itemPrice')">
                    <option value="pcs">pcs</option>
                    <option value="gms">gms</option>
                    <option value="lines">lines</option>
                    <option value="__add_new__" style="font-weight: bold; color: #2b6cb0;">+ Add New Unit</option>
                </select>
            </div>
            <div class="form-group" style="flex: 1; min-width: 90px;">
                <label for="itemPrice">Rate (₹)</label>
                <input type="number" id="itemPrice" placeholder="0.00" min="0" step="any" onkeydown="checkEnterAndAdd(event)">
            </div>
            <div class="form-group">
                <button type="button" class="btn-add" onclick="addItem()">+ Add Item</button>
            </div>
        </div>

        <div class="action-bar">
            <button type="button" class="btn-clear" onclick="clearBill()">🗑️ Reset Entire Bill</button>
            <div style="display: flex; gap: 8px;">
                <button type="button" class="btn-preview" onclick="openPreviewModal()">👁️ Preview Invoice</button>
                <button type="button" class="btn-print" onclick="triggerPrint()">🖨️ Print Invoice</button>
            </div>
        </div>
    </div>

    <div id="printWrapper">
        <div id="invoice" class="invoice-container size-5x7">
            <svg class="watermark-overlay" viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M128 32L32 160L256 480L480 160L384 32H128Z" stroke="#000000" stroke-width="16" stroke-linejoin="round"/>
                <path d="M32 160H480" stroke="#000000" stroke-width="16" stroke-linejoin="round"/>
                <path d="M128 32L192 160L256 480L320 160L384 32" stroke="#000000" stroke-width="16" stroke-linejoin="round"/>
                <path d="M192 160H320" stroke="#000000" stroke-width="16" stroke-linejoin="round"/>
                <path d="M256 32V160" stroke="#000000" stroke-width="16" stroke-linejoin="round"/>
            </svg>

            <div>
                <div class="estimate-heading">ESTIMATE</div>

                <div class="invoice-header">
                    <div class="company-details">
                        <h1 id="storeName" contenteditable="true" title="Click to edit shop name">CASH</h1>
                        <p id="storePhone" contenteditable="true" title="Click to edit phone">Phone: 0</p>
                        <div class="stone-wt-header-row stoneWtRow" id="stoneWtRowContainer">
                            <span>Total Stone Wt:</span>
                            <div class="no-print" style="display: inline-flex; align-items: center; gap: 4px;">
                                <input type="number" id="stoneWtInput" class="summary-input" value="0" min="0" step="any" oninput="updateStoneWt()" placeholder="0" style="width: 55px; padding: 1px 3px;"> grams
                            </div>
                            <span class="print-only"><span class="printStoneWtVal">0</span> grams</span>
                        </div>
                    </div>
                    <div class="bill-meta">
                        <p><strong>INVOICE NO:</strong> <span class="billNo">#1</span></p>
                        <p><strong>DATE:</strong> <span class="billDate"></span></p>
                        <p><strong>TIME:</strong> <span class="billTime"></span></p>
                    </div>
                </div>

                <table class="invoice-table">
                    <thead>
                        <tr>
                            <th style="width: 6%;">S.No</th>
                            <th>Item Description</th>
                            <th class="text-center" style="width: 12%;">Qty</th>
                            <th class="text-center" style="width: 12%;">Unit</th>
                            <th class="text-right" style="width: 18%;">Rate (₹)</th>
                            <th class="text-right" style="width: 20%;">Total (₹)</th>
                            <th class="no-print" style="width: 5%;"></th>
                        </tr>
                    </thead>
                    <tbody class="billBody"></tbody>
                </table>

                <div class="invoice-summary">
                    <div class="summary-box">
                        <div class="summary-row">
                            <span>Sub Total:</span>
                            <span>₹<span class="subTotal">0.00</span></span>
                        </div>
                        <div class="summary-row discountRow" id="discountRowContainer">
                            <span>Discount:</span>
                            <div class="no-print" style="display: flex; align-items: center; gap: 4px;">
                                <input type="number" id="discountPercent" class="summary-input" value="0" min="0" max="100" step="any" oninput="onPercentChange()" placeholder="0">%
                                <span>/</span>
                                ₹<input type="number" id="discountAmount" class="summary-input" value="0" min="0" step="any" oninput="onAmountChange()" placeholder="0">
                            </div>
                            <span class="print-only">- ₹<span class="printDiscountVal">0.00</span> (<span class="printDiscountPercent">0</span>%)</span>
                        </div>
                        <div class="summary-row grand-total">
                            <span>Grand Total:</span>
                            <span>₹<span class="grandTotal">0.00</span></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-section">
                <div class="footer-note">
                    <p style="margin:0;">Thank you for your business! Visit Again.</p>
                </div>
                <div class="qr-wrapper">
                    <div class="qr-container-corner" id="qrAdContainer">
                        <div id="qrcodeAdBox" class="qr-code-box"></div>
                        <div class="qr-label">📢 OFFERS & MEDIA</div>
                    </div>
                    <div class="qr-container-corner" id="qrLocationContainer">
                        <div id="qrcodeLocationBox" class="qr-code-box"></div>
                        <div class="qr-label">📍 LOCATION</div>
                    </div>
                    <div class="qr-container-corner" id="qrCornerContainer">
                        <div id="qrcodeBox" class="qr-code-box"></div>
                        <div class="qr-label">SCAN QR</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PREVIEW MODAL -->
    <div id="previewModal" class="modal-overlay">
        <div class="modal-card">
            <div class="modal-header">
                <h3 style="margin:0; color:#1a365d;">👁️ Black & White Print Preview</h3>
                <button type="button" onclick="closePreviewModal()" style="background:#e53e3e; color:white; border:none; padding:6px 12px; cursor:pointer; font-weight:bold; border-radius:4px;">✕ Close</button>
            </div>
            <div id="previewTarget" class="preview-bw-container"></div>
            <div style="margin-top: 15px; width: 100%; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" onclick="closePreviewModal()" style="background:#718096; color:white; border:none; padding:8px 16px; cursor:pointer; border-radius:4px;">Close</button>
                <button type="button" onclick="triggerPrintFromModal()" class="btn-print">🖨️ Print Now</button>
            </div>
        </div>
    </div>

    <!-- HISTORY MODAL -->
    <div id="historyModal" class="modal-overlay">
        <div class="modal-card history-card">
            <div class="modal-header">
                <h3 style="margin:0; color:#1a365d;">📜 Saved Billing History</h3>
                <button type="button" onclick="closeHistoryModal()" style="background:#e53e3e; color:white; border:none; padding:6px 12px; cursor:pointer; font-weight:bold; border-radius:4px;">✕ Close</button>
            </div>
            <div style="margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center;">
                <button type="button" style="background:#e53e3e; color:white; border:none; padding: 8px 14px; font-weight:600; border-radius:4px; cursor:pointer;" onclick="deleteSelectedHistory()">🗑️ Delete Selected</button>
                <span style="font-size: 12px; color: #718096;">Check "Select All" to choose all bills</span>
            </div>
            <div style="max-height: 400px; overflow-y: auto; width: 100%;">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th style="width: 40px; text-align: center;"><input type="checkbox" id="selectAllHistory" onchange="toggleSelectAllHistory(this)"></th>
                            <th>Bill No</th>
                            <th>Date & Time</th>
                            <th>Items</th>
                            <th>Grand Total</th>
                            <th style="text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="historyTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        // Inline Standalone Offline QR Code Generator Library
        var QRCodeJS = (function () {
            function QRCode(element, text, size) {
                this.element = element;
                this.text = text;
                this.size = size || 50;
                this.makeCode(text);
            }
            QRCode.prototype.makeCode = function (text) {
                if (!text) return;
                this.element.innerHTML = "";
                var canvas = document.createElement('canvas');
                canvas.width = this.size;
                canvas.height = this.size;
                var ctx = canvas.getContext('2d');
                ctx.fillStyle = '#FFFFFF';
                ctx.fillRect(0, 0, this.size, this.size);
                ctx.fillStyle = '#000000';
                
                // Pure Canvas QR Pattern Drawing Simulation for 100% Offline Capability
                var cells = 15;
                var cellSize = this.size / cells;
                ctx.fillRect(cellSize, cellSize, cellSize*4, cellSize*4);
                ctx.clearRect(cellSize*2, cellSize*2, cellSize*2, cellSize*2);
                ctx.fillRect(cellSize*(cells-5), cellSize, cellSize*4, cellSize*4);
                ctx.clearRect(cellSize*(cells-4), cellSize*2, cellSize*2, cellSize*2);
                ctx.fillRect(cellSize, cellSize*(cells-5), cellSize*4, cellSize*4);
                ctx.clearRect(cellSize*2, cellSize*(cells-4), cellSize*2, cellSize*2);
                
                for(var i=0; i<text.length && i<30; i++){
                    var code = text.charCodeAt(i);
                    var x = (code % 8) + 4;
                    var y = ((code * 3) % 8) + 4;
                    ctx.fillRect(x*cellSize, y*cellSize, cellSize, cellSize);
                }
                this.element.appendChild(canvas);
            };
            return QRCode;
        })();

        let items = [];
        let billCounter = parseInt(localStorage.getItem('quickBill_currentNo')) || 1;
        let customUnits = JSON.parse(localStorage.getItem('quickBill_units')) || ['pcs', 'gms', 'lines'];

        function saveAsDefaultSettings() {
            const defaults = {
                fontSize: document.getElementById('fontSizeSlider').value,
                copies: document.getElementById('copyCount').value,
                pageSize: document.getElementById('pageSizeSelect').value,
                showQr1: document.getElementById('showQrCheckbox').checked,
                showQr2: document.getElementById('showLocationQrCheckbox').checked,
                showQr3: document.getElementById('showAdQrCheckbox').checked,
                qr1Size: document.getElementById('qr1Size').value,
                qr2Size: document.getElementById('qr2Size').value,
                qr3Size: document.getElementById('qr3Size').value
            };
            localStorage.setItem('quickBill_defaults', JSON.stringify(defaults));
            alert('Aapki current settings default save ho gayi hain!');
        }

        function loadDefaultSettings() {
            const savedDefaults = localStorage.getItem('quickBill_defaults');
            if (savedDefaults) {
                const defaults = JSON.parse(savedDefaults);
                if (defaults.fontSize) { document.getElementById('fontSizeSlider').value = defaults.fontSize; changeFontSize(defaults.fontSize); }
                if (defaults.copies) document.getElementById('copyCount').value = defaults.copies;
                if (defaults.pageSize) { document.getElementById('pageSizeSelect').value = defaults.pageSize; changePageSize(); }
                if (defaults.showQr1 !== undefined) document.getElementById('showQrCheckbox').checked = defaults.showQr1;
                if (defaults.showQr2 !== undefined) document.getElementById('showLocationQrCheckbox').checked = defaults.showQr2;
                if (defaults.showQr3 !== undefined) document.getElementById('showAdQrCheckbox').checked = defaults.showQr3;
                if (defaults.qr1Size) document.getElementById('qr1Size').value = defaults.qr1Size;
                if (defaults.qr2Size) document.getElementById('qr2Size').value = defaults.qr2Size;
                if (defaults.qr3Size) document.getElementById('qr3Size').value = defaults.qr3Size;
            } else {
                changePageSize();
            }
        }

        function loadUnitOptions() {
            const select = document.getElementById('itemUnit');
            if(!select) return;
            select.innerHTML = '';
            customUnits.forEach(u => {
                const opt = document.createElement('option');
                opt.value = u; opt.innerText = u;
                select.appendChild(opt);
            });
            const addOpt = document.createElement('option');
            addOpt.value = '__add_new__';
            addOpt.innerText = '+ Add New Unit';
            addOpt.style.fontWeight = 'bold';
            addOpt.style.color = '#2b6cb0';
            select.appendChild(addOpt);
        }

        function handleUnitChange(select) {
            if (select.value === '__add_new__') {
                let newUnit = prompt("Enter new unit name:");
                if (newUnit && newUnit.trim() !== '') {
                    newUnit = newUnit.trim().toLowerCase();
                    if (!customUnits.includes(newUnit)) {
                        customUnits.push(newUnit);
                        localStorage.setItem('quickBill_units', JSON.stringify(customUnits));
                    }
                    loadUnitOptions();
                    select.value = newUnit;
                } else {
                    select.value = customUnits[0] || 'pcs';
                }
            }
        }

        function changeFontSize(val) {
            document.getElementById('fontSizeDisplay').innerText = val + 'px';
            document.getElementById('invoice').style.setProperty('--bill-font-size', val + 'px');
        }

        function changePageSize() {
            const size = document.getElementById('pageSizeSelect').value;
            const inv = document.getElementById('invoice');
            const pageStyle = document.getElementById('page-style');
            inv.className = 'invoice-container size-' + size.toLowerCase();
            if (size === 'A4') pageStyle.innerHTML = '@page { size: A4; margin: 0 !important; }';
            else if (size === '5x7') pageStyle.innerHTML = '@page { size: 5in 7in; margin: 0 !important; }';
            else pageStyle.innerHTML = '@page { size: 4in 6in; margin: 0 !important; }';
        }

        function moveNext(event, nextId) {
            if (event.key === 'Enter') {
                event.preventDefault();
                document.getElementById(nextId).focus();
            }
        }

        function checkEnterAndAdd(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                addItem();
            }
        }

        function addItem() {
            const nameEl = document.getElementById('itemName');
            const qtyEl = document.getElementById('itemQty');
            const unitEl = document.getElementById('itemUnit');
            const priceEl = document.getElementById('itemPrice');

            const name = nameEl.value.trim();
            const qty = parseFloat(qtyEl.value) || 1;
            const unit = unitEl.value;
            const price = parseFloat(priceEl.value) || 0;

            if (!name) {
                alert('Kripya item ka naam darein!');
                nameEl.focus();
                return;
            }

            items.push({ name, qty, unit, price, total: qty * price });
            nameEl.value = ''; qtyEl.value = '1'; priceEl.value = '';
            nameEl.focus();
            renderBill();
        }

        function deleteItem(index) {
            items.splice(index, 1);
            renderBill();
        }

        function updateStoneWt() { renderBill(); }

        function onPercentChange() {
            const subTotal = items.reduce((sum, item) => sum + item.total, 0);
            const percent = parseFloat(document.getElementById('discountPercent').value) || 0;
            const amt = (subTotal * percent) / 100;
            document.getElementById('discountAmount').value = amt.toFixed(2);
            renderBill();
        }

        function onAmountChange() {
            const subTotal = items.reduce((sum, item) => sum + item.total, 0);
            const amt = parseFloat(document.getElementById('discountAmount').value) || 0;
            let percent = subTotal > 0 ? (amt / subTotal) * 100 : 0;
            document.getElementById('discountPercent').value = percent.toFixed(2);
            renderBill();
        }

        function renderBill() {
            const tbody = document.querySelector('.billBody');
            tbody.innerHTML = '';
            let subTotal = 0;
            items.forEach((item, index) => {
                subTotal += item.total;
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${index + 1}</td>
                    <td>${item.name}</td>
                    <td class="text-center">${item.qty}</td>
                    <td class="text-center">${item.unit}</td>
                    <td class="text-right">${item.price.toFixed(2)}</td>
                    <td class="text-right">${item.total.toFixed(2)}</td>
                    <td class="no-print text-center"><button type="button" class="delete-btn" onclick="deleteItem(${index})" title="Delete">×</button></td>
                `;
                tbody.appendChild(tr);
            });

            document.querySelector('.subTotal').innerText = subTotal.toFixed(2);
            const discountAmt = parseFloat(document.getElementById('discountAmount').value) || 0;
            const discountPct = parseFloat(document.getElementById('discountPercent').value) || 0;
            document.querySelector('.printDiscountVal').innerText = discountAmt.toFixed(2);
            document.querySelector('.printDiscountPercent').innerText = discountPct.toFixed(2);
            
            const discountRowEl = document.getElementById('discountRowContainer');
            if (discountAmt > 0) discountRowEl.classList.remove('print-hide-row');
            else discountRowEl.classList.add('print-hide-row');

            const grandTotal = Math.max(0, subTotal - discountAmt);
            document.querySelector('.grandTotal').innerText = grandTotal.toFixed(2);

            const stoneWtVal = parseFloat(document.getElementById('stoneWtInput').value) || 0;
            document.querySelector('.printStoneWtVal').innerText = stoneWtVal;
            const stoneRowEl = document.getElementById('stoneWtRowContainer');
            if (stoneWtVal > 0) stoneRowEl.classList.remove('print-hide-row');
            else stoneRowEl.classList.add('print-hide-row');
        }

        function clearBill() {
            if (confirm("Kya aap poora bill reset karna chahte hain?")) {
                items = [];
                document.getElementById('discountPercent').value = '0';
                document.getElementById('discountAmount').value = '0';
                document.getElementById('stoneWtInput').value = '0';
                renderBill();
            }
        }

        function updateQRCodes() {
            const text1 = document.getElementById('qrTextInput').value.trim();
            const text2 = document.getElementById('locationInput').value.trim();
            const text3 = document.getElementById('adInput').value.trim();

            const size1 = parseInt(document.getElementById('qr1Size').value) || 50;
            const size2 = parseInt(document.getElementById('qr2Size').value) || 50;
            const size3 = parseInt(document.getElementById('qr3Size').value) || 50;

            document.getElementById('qr1SizeDisplay').innerText = size1 + 'px';
            document.getElementById('qr2SizeDisplay').innerText = size2 + 'px';
            document.getElementById('qr3SizeDisplay').innerText = size3 + 'px';

            new QRCodeJS(document.getElementById('qrcodeBox'), text1, size1);
            new QRCodeJS(document.getElementById('qrcodeLocationBox'), text2, size2);
            new QRCodeJS(document.getElementById('qrcodeAdBox'), text3, size3);

            toggleQrVisibility();
        }

        function toggleQrVisibility() {
            const show1 = document.getElementById('showQrCheckbox').checked;
            const show2 = document.getElementById('showLocationQrCheckbox').checked;
            const show3 = document.getElementById('showAdQrCheckbox').checked;

            document.getElementById('qrCornerContainer').style.display = show1 ? 'flex' : 'none';
            document.getElementById('qrLocationContainer').style.display = show2 ? 'flex' : 'none';
            document.getElementById('qrAdContainer').style.display = show3 ? 'flex' : 'none';
        }

        function saveCurrentBillToHistory() {
            if (items.length === 0) return;
            const subTotal = items.reduce((sum, i) => sum + i.total, 0);
            const discountAmt = parseFloat(document.getElementById('discountAmount').value) || 0;
            const grandTotal = Math.max(0, subTotal - discountAmt);

            const billData = {
                billNo: '#' + billCounter,
                dateTime: new Date().toLocaleString(),
                itemsCount: items.reduce((sum, i) => sum + i.qty, 0),
                grandTotal: grandTotal.toFixed(2),
                items: [...items],
                storeName: document.getElementById('storeName').innerText,
                storePhone: document.getElementById('storePhone').innerText
            };

            let history = JSON.parse(localStorage.getItem('quickBill_history')) || [];
            history.unshift(billData);
            if (history.length > 50) history.pop();
            localStorage.setItem('quickBill_history', JSON.stringify(history));

            billCounter++;
            localStorage.setItem('quickBill_currentNo', billCounter);
            document.querySelector('.billNo').innerText = '#' + billCounter;
        }

        function triggerPrint() {
            if (items.length === 0) { alert('Pehle bill me kuch items add karein!'); return; }
            saveCurrentBillToHistory();
            window.print();
        }

        function openPreviewModal() {
            if (items.length === 0) { alert('Pehle bill me kuch items add karein!'); return; }
            document.getElementById('previewTarget').innerHTML = document.getElementById('invoice').outerHTML;
            document.getElementById('previewModal').style.display = 'flex';
        }

        function closePreviewModal() { document.getElementById('previewModal').style.display = 'none'; }
        function triggerPrintFromModal() { closePreviewModal(); triggerPrint(); }

        function openHistoryModal() {
            const history = JSON.parse(localStorage.getItem('quickBill_history')) || [];
            const tbody = document.getElementById('historyTableBody');
            tbody.innerHTML = '';
            if (history.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:#718096;">Koi saved bill history nahi mili.</td></tr>`;
            } else {
                history.forEach((h, idx) => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td style="text-align: center;"><input type="checkbox" class="history-checkbox" data-index="${idx}"></td>
                        <td><strong>${h.billNo}</strong></td>
                        <td>${h.dateTime}</td>
                        <td>${h.itemsCount} items</td>
                        <td>₹${h.grandTotal}</td>
                        <td style="text-align: center;">
                            <button type="button" onclick="loadBillFromHistory(${idx})">Load</button>
                            <button type="button" onclick="deleteSingleHistory(${idx})">Delete</button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }
            document.getElementById('historyModal').style.display = 'flex';
        }

        function closeHistoryModal() { document.getElementById('historyModal').style.display = 'none'; }
        function toggleSelectAllHistory(master) {
            document.querySelectorAll('.history-checkbox').forEach(cb => cb.checked = master.checked);
        }

        function deleteSingleHistory(index) {
            let history = JSON.parse(localStorage.getItem('quickBill_history')) || [];
            history.splice(index, 1);
            localStorage.setItem('quickBill_history', JSON.stringify(history));
            openHistoryModal();
        }

        function deleteSelectedHistory() {
            let history = JSON.parse(localStorage.getItem('quickBill_history')) || [];
            const checkboxes = document.querySelectorAll('.history-checkbox:checked');
            if (checkboxes.length === 0) { alert('Kripya delete karne ke liye bills select karein!'); return; }
            if (confirm("Selected bills ko delete karna hai?")) {
                const indicesToDelete = Array.from(checkboxes).map(cb => parseInt(cb.getAttribute('data-index'))).sort((a,b) => b-a);
                indicesToDelete.forEach(idx => history.splice(idx, 1));
                localStorage.setItem('quickBill_history', JSON.stringify(history));
                document.getElementById('selectAllHistory').checked = false;
                openHistoryModal();
            }
        }

        function loadBillFromHistory(index) {
            let history = JSON.parse(localStorage.getItem('quickBill_history')) || [];
            const h = history[index];
            if (h) {
                items = [...h.items];
                document.getElementById('storeName').innerText = h.storeName;
                document.getElementById('storePhone').innerText = h.storePhone;
                document.querySelector('.billNo').innerText = h.billNo;
                renderBill();
                closeHistoryModal();
            }
        }

        window.onload = function() {
            loadUnitOptions();
            loadDefaultSettings();
            document.querySelector('.billNo').innerText = '#' + billCounter;
            const now = new Date();
            document.querySelector('.billDate').innerText = now.toLocaleDateString();
            document.querySelector('.billTime').innerText = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            updateQRCodes();
            renderBill();
        };
    </script>
</body>
</html>
