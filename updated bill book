<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuickBill Pro - Billing Software</title>
    <style id="page-style">
        @page {
            size: 5in 7in;
            margin: 0 !important;
        }
    </style>
    <!-- QRCode.js Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f0f2f5;
            margin: 0;
            padding: 20px;
            color: #333;
        }

        .control-panel {
            background: #ffffff;
            padding: 18px 20px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            width: 100%;
            max-width: 950px;
            margin: 0 auto 25px auto;
            border: 1px solid #e1e4e8;
            display: block !important;
        }

        .panel-header {
            font-size: 16px;
            font-weight: 700;
            color: #1a365d;
            margin-bottom: 15px;
            border-bottom: 2px solid #edf2f7;
            padding-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .settings-bar {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 15px;
            background: #f8fafc;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
        }

        .setting-box {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .btn-save-default {
            background-color: #2b6cb0;
            color: white;
            font-weight: 600;
            font-size: 12px;
            cursor: pointer;
            border: none;
            padding: 7px 12px;
            border-radius: 6px;
            margin-left: 8px;
        }

        .btn-save-default:hover { background-color: #2c5282; }

        .btn-history {
            background-color: #4c51bf;
            color: white;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            border: none;
            padding: 7px 14px;
            border-radius: 6px;
            margin-left: auto;
        }

        .btn-history:hover { background-color: #434190; }

        .form-grid {
            display: flex;
            gap: 12px;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label, .setting-box label {
            font-size: 11px;
            font-weight: 700;
            color: #4a5568;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        input, select, textarea, button {
            padding: 8px 10px;
            border: 1px solid #cbd5e0;
            border-radius: 6px;
            font-size: 13px;
            outline: none;
            transition: all 0.2s ease;
        }

        input:focus, select:focus, textarea:focus {
            border-color: #3182ce;
            box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.15);
        }

        .btn-add {
            background-color: #2b6cb0;
            color: white;
            font-weight: 600;
            cursor: pointer;
            border: none;
            height: 38px;
            align-self: flex-end;
        }

        .btn-add:hover { background-color: #2c5282; }

        .btn-preview {
            background-color: #4a5568;
            color: white;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
        }

        .btn-preview:hover { background-color: #2d3748; }

        .btn-print {
            background-color: #2f855a;
            color: white;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
        }

        .btn-print:hover { background-color: #276749; }

        .btn-clear {
            background-color: #e53e3e;
            color: white;
            font-weight: 600;
            cursor: pointer;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
        }

        .btn-clear:hover { background-color: #c53030; }

        .action-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px dashed #e2e8f0;
        }

        .invoice-container {
            --bill-font-size: 11px;
            background: #ffffff;
            margin: 0 auto 20px auto;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            transition: all 0.3s ease;
            box-sizing: border-box;
            font-size: var(--bill-font-size) !important;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            z-index: 1;
        }

        /* Diamond Watermark Styling */
        .watermark-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 55%;
            height: auto;
            opacity: 0.06;
            pointer-events: none;
            z-index: -1;
        }

        .invoice-container *,
        .invoice-container h1,
        .invoice-container p,
        .invoice-container td,
        .invoice-container th,
        .invoice-container span,
        .invoice-container div,
        .invoice-container input {
            font-size: var(--bill-font-size) !important;
            line-height: 1.2;
        }

        .estimate-heading {
            text-align: center;
            font-size: 12px !important;
            font-weight: 800;
            letter-spacing: 1.5px;
            margin-bottom: 6px;
            text-transform: uppercase;
            color: #000;
        }

        .size-a4 { width: 210mm; min-height: 297mm; }
        .size-4x6 { width: 4in; height: 5.8in; padding: 10px !important; }
        .size-5x7 { width: 5in; height: 6.8in; padding: 12px !important; }

        .invoice-header {
            display: flex;
            justify-content: space-between;
            border-bottom: 1.5px solid #000;
            padding-bottom: 6px;
            margin-bottom: 8px;
        }

        .company-details h1 {
            margin: 0;
            font-weight: 700;
            color: #000;
            text-transform: uppercase;
            outline: none;
        }

        .company-details p {
            margin: 2px 0;
            color: #000;
            outline: none;
        }

        .stone-wt-header-row {
            margin-top: 4px;
            font-weight: bold;
            color: #000;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .bill-meta { text-align: right; }
        .bill-meta p { margin: 2px 0; }
        .bill-meta span { font-weight: bold; color: #000; }

        .invoice-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 8px;
        }

        .invoice-table th {
            background-color: #f0f0f0;
            color: #000;
            font-weight: 700;
            text-transform: uppercase;
            padding: 4px 6px;
            border-bottom: 1.5px solid #000;
            text-align: left;
        }

        .invoice-table td {
            padding: 4px 6px;
            border-bottom: 1px solid #ccc;
            color: #000;
        }

        .text-right { text-align: right !important; }
        .text-center { text-align: center !important; }

        .invoice-summary { display: flex; justify-content: flex-end; margin-top: 6px; }
